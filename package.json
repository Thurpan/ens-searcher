{
  "name": "ens-searcher",
  "version": "0.1.0",
  "description": "Scan candidate ENS .eth names, store scan history in SQLite, and query saved results.",
  "private": true,
  "license": "MIT-0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thurpan/ens-searcher.git"
  },
  "bugs": {
    "url": "https://github.com/Thurpan/ens-searcher/issues"
  },
  "homepage": "https://github.com/Thurpan/ens-searcher#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "oxlint --config oxlint.config.ts .",
    "scan": "tsx src/scan.ts",
    "query": "tsx src/query.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "oxlint": "^1.78.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
